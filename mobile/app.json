{
  "expo": {
    "name": "Mess QR",
    "slug": "mess-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "messqr",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9fafb"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.messqr.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is needed to scan student QR codes.",
        "NSPhotoLibraryUsageDescription": "Photo library access for profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.messqr.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mess QR to access your camera for scanning QR codes."
        }
      ],
      "expo-brightness"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a3e278f9-8b27-47a5-8308-7050659325d7"
      }
    }
  }
}
