# ============================================================
# Mess QR Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# ── Supabase ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Upstash Redis ─────────────────────────────────────────────
# Get these from: console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ── JWT Secrets ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── QR Signing ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
QR_HMAC_SECRET=replace-with-a-long-random-string-for-qr-signing

# ── Gmail SMTP ────────────────────────────────────────────────
# Use your college/personal Gmail + a Google App Password
# (NOT your normal Gmail password — generate App Password at:
#  myaccount.google.com → Security → 2-Step Verification → App passwords)
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM_NAME=Mess QR System

# ── OTP Settings ──────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=5

# ── CORS ──────────────────────────────────────────────────────
# In production: set to your admin dashboard URL
# e.g., https://mess-admin.vercel.app
# For dev, use * or http://localhost:5173
CORS_ORIGIN=*
